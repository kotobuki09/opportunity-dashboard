{
  "name": "opportunity-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-data.mjs && vite",
    "data": "node scripts/gen-data.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/gen-data.mjs && tsc -b && vite build",
    "check": "npm run validate && npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "node scripts/gen-data.mjs && tsc --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
